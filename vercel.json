{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/submit\\.php", "destination": "/api/submit" },
    { "source": "/admin/login\\.php", "destination": "/admin/index.html" },
    { "source": "/admin/index\\.php", "destination": "/admin/index.html" },
    { "source": "/admin/view\\.php", "destination": "/admin/index.html" },
    { "source": "/admin/export\\.php", "destination": "/api/applications/export" },
    { "source": "/admin/media\\.php", "destination": "/admin/index.html" },
    { "source": "/admin/logout\\.php", "destination": "/admin/index.html" },
    { "source": "/admin/update_status\\.php", "destination": "/api/applications/update" }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}